# ===== Identidade / rede =====
# Uma porta por app (ver apps.json / docs/APPS.md). Proxima livre: 8005.
HOST=0.0.0.0
PORT=8005

# ===== Banco =====
DB_PATH=./data.db

# ===== Auth (usuario unico) =====
# Primeira subida: se nao existir usuario, cria com estes valores.
ADMIN_USERNAME=admin
# Deixe vazio para gerar uma senha aleatoria (impressa no log/journalctl).
ADMIN_PASSWORD=

# Assinatura da sessao/CSRF. Deixe vazio para gerar e persistir em <DATA_DIR>/secret.key.
SECRET_KEY=

# HTTPS. Em LAN puro (HTTP) deixe false. Via Tailscale MagicDNS pode ligar true.
COOKIE_SECURE=false

# ===== Publicacao (GitHub -> Netlify) =====
# PAT com contents:write no repo do portfolio (fine-grained, so esse repo).
GITHUB_TOKEN=
GITHUB_OWNER=Igorls34
GITHUB_REPO=portfolio-igordev-ofc
GITHUB_BRANCH=main
# Caminhos dentro do repo do portfolio
PORTFOLIO_JSON_PATH=data/portfolio.json
PORTFOLIO_CERTS_DIR=certificados_webp

# (Opcional) Build hook da Netlify como gatilho extra. O push ja dispara o Actions.
NETLIFY_BUILD_HOOK=

# ===== Uploads (certificados) =====
# Pasta onde os WebP convertidos ficam antes do publish. Default: <dir do db>/uploads/certs
# UPLOADS_DIR=

# ===== CORS (dev local) =====
CORS_ORIGINS=
